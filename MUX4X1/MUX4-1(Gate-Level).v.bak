module MUX_4_GL
(
  input  wire [3:0] d,
  input  wire [1:0] s,

  output wire y
);
   //(1) declearing the wires
   wire not_s1, not_s0, and0, and1, and2, and3; 
  
  //(2) gates not's stage 
  not not0 (not_s0, s[0]);
  not not1 (not_s1, s[1]);
  
  //(3) gates and's stage 
  and AND0 (and_s0, d[0], not_s0, not_s1);
  and AND1 (and_s1, d[1], not_s1, s[0]);
  and AND2 (and_s2, d[2], not_s0, s[1]);
  and AND3 (and_s3, d[3], s[0], s[1]);

  //(4) gates or's stage 
   or oor0 (y, and_s0, and_s1, and_s2, and_s3);

endmodule

 

